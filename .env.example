# ─────────────────────────────────────────────────────────────
# .env.local — JANGAN di-commit ke Git!
# Copy file ini → rename jadi .env.local → isi nilai-nya
# ─────────────────────────────────────────────────────────────

# 1. Groq API Key (gratis di console.groq.com)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 2. API Key buatan sendiri — bebas tentukan string apapun
#    Ini yang Anda kirim di header: x-api-key
#    Contoh: MY_API_KEY=rahasia_kuat_2024_xZ9
MY_API_KEY=ganti_dengan_api_key_anda_sendiri
